{
  "name": "@mithril/system-one",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "examples/todo"
  ],
  "exports": {
    ".": "./lib/mithril-language.mjs",
    "./todo": "./lib/inference.mjs",
    "./convert": "./lib/source-to-mithril.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs && npm test -w examples/todo",
    "test:browser": "npm run test:browser -w examples/todo --",
    "test:python": "python3 -m unittest discover -s test -p \"test_*.py\"",
    "test:all": "npm test && npm run test:python && npm run test:browser",
    "status": "node bin/system-one.mjs status",
    "setup:dynamic": "node runtime/setup.mjs",
    "test:dynamic": "node --test test/dynamic-runtime.integration.mjs test/registry-runtime.integration.mjs",
    "test:security": "node --test test/security-ontology.test.mjs test/security-runtime.integration.mjs",
    "test:public-review": "node --test test/public-code-review.test.mjs test/public-review-runtime.integration.mjs",
    "setup:module": "node runtime/setup-module.mjs",
    "test:convert": "node --test test/source-conversion.test.mjs test/source-conversion.integration.mjs && python3 test/source_convert_adapter.integration.py"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  },
  "dependencies": {
    "@babel/parser": "7.28.4",
    "acorn": "8.15.0"
  }
}
